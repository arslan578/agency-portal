# Kaivo Production Environment Configuration
# Generated based on env.example and codebase analysis

# --- Database ---
# Connection string for the PostgreSQL database
DATABASE_URL=CHANGE_ME_PRODUCTION

# --- Redis ---
# Connection string for Redis (used by Celery)
REDIS_URL=CHANGE_ME_PRODUCTION

# --- AI Services ---
# API Key for OpenAI (GPT-4)
OPENAI_API_KEY=CHANGE_ME_PRODUCTION

# --- Payments ---
# Stripe Secret Key for billing
STRIPE_SECRET_KEY=CHANGE_ME_PRODUCTION

# --- Authentication ---
# Secret used to sign session tokens (generate a random string)
NEXTAUTH_SECRET=CHANGE_ME_PRODUCTION
# URL of the application (e.g., https://app.getkaivo.com)
NEXTAUTH_URL=https://app.getkaivo.com
# Frontend URL
NEXT_PUBLIC_APP_URL=https://app.getkaivo.com
# Backend URL
NEXT_PUBLIC_API_URL=https://api.getkaivo.com
# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://app.getkaivo.com
# Allowed Hosts
ALLOWED_HOSTS=api.getkaivo.com
# Google OAuth Credentials
GOOGLE_CLIENT_ID=CHANGE_ME_PRODUCTION
GOOGLE_CLIENT_SECRET=CHANGE_ME_PRODUCTION

# --- Infrastructure (CI/CD Only) ---
# Kubernetes Config (Base64 encoded or raw YAML)
KUBE_CONFIG=CHANGE_ME_PRODUCTION
# GitHub Container Registry Token
GHCR_TOKEN=CHANGE_ME_PRODUCTION







