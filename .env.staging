# Kaivo Staging Environment Configuration
# Generated based on env.example and codebase analysis

# --- Database ---
# Connection string for the PostgreSQL database
DATABASE_URL=CHANGE_ME_STAGING

# --- Redis ---
# Connection string for Redis (used by Celery)
REDIS_URL=CHANGE_ME_STAGING

# --- AI Services ---
# API Key for OpenAI (GPT-4)
OPENAI_API_KEY=CHANGE_ME_STAGING

# --- Payments ---
# Stripe Secret Key for billing
STRIPE_SECRET_KEY=CHANGE_ME_STAGING

# --- Shopify Integration ---
# Shopify App API Key (from Shopify Partners dashboard)
SHOPIFY_API_KEY=CHANGE_ME_STAGING
# Shopify App API Secret (from Shopify Partners dashboard)
SHOPIFY_API_SECRET=CHANGE_ME_STAGING
# Shopify App URL (e.g., https://staging.app.getkaivo.com)
SHOPIFY_APP_URL=https://staging.app.getkaivo.com
# Shopify OAuth Scopes (comma-separated, e.g., read_products,write_products)
SHOPIFY_SCOPES=read_products,write_products

# --- Authentication ---
# Secret used to sign session tokens (generate a random string)
NEXTAUTH_SECRET=CHANGE_ME_STAGING
# URL of the application (e.g., https://staging.app.getkaivo.com)
NEXTAUTH_URL=https://staging.app.getkaivo.com
# Frontend URL
NEXT_PUBLIC_APP_URL=https://staging.app.getkaivo.com
# Backend URL
NEXT_PUBLIC_API_URL=https://staging.api.getkaivo.com
# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://staging.app.getkaivo.com
# Allowed Hosts
ALLOWED_HOSTS=staging.api.getkaivo.com
# Google OAuth Credentials
GOOGLE_CLIENT_ID=CHANGE_ME_STAGING
GOOGLE_CLIENT_SECRET=CHANGE_ME_STAGING

# --- Infrastructure (CI/CD Only) ---
# Kubernetes Config (Base64 encoded or raw YAML)
KUBE_CONFIG=CHANGE_ME_STAGING
# GitHub Container Registry Token
GHCR_TOKEN=CHANGE_ME_STAGING

# --- OS-65 Flags ---
FF_OS_CONNECTOR_REGISTRATION=true

# --- Connector Runtime Flags ---
FF_GOOGLE_ADS_CONNECTOR_IO=true
FF_META_ADS_CONNECTOR=true
FF_TIKTOK_ADS_CONNECTOR_ENGINE=true

# --- PIB Google Flags ---
FF_PIB_GOOGLE_PHASE_1=true
FF_PIB_GOOGLE_PHASE_2=true
FF_PIB_GOOGLE_PHASE_3=true
FF_PIB_GOOGLE_PHASE_4=true
FF_PIB_GOOGLE_PHASE_5=true
FF_PIB_GOOGLE_PHASE_6=true
FF_PIB_GOOGLE_PHASE_7=true
FF_PIB_GOOGLE_PHASE_8=true
FF_PIB_GOOGLE_PHASE_9=true
FF_PIB_GOOGLE_PHASE_10=true
FF_PIB_GOOGLE_PHASE_11=true
FF_PIB_GOOGLE_PHASE_12=true
FF_PIB_GOOGLE_PHASE_13=true

# --- PIB Meta Flags ---
FF_PIB_META_PHASE_1=true
FF_PIB_META_PHASE_2=true
FF_PIB_META_PHASE_3=true
FF_PIB_META_PHASE_4=true
FF_PIB_META_PHASE_5=true
FF_PIB_META_PHASE_6=true
FF_PIB_META_PHASE_7=true
FF_PIB_META_PHASE_8=true
FF_PIB_META_PHASE_9=true
FF_PIB_META_PHASE_10=true
FF_PIB_META_PHASE_11=true
FF_PIB_META_PHASE_12=true

# --- PIB TikTok Flags ---
FF_PIB_TIKTOK_PHASE_1=true
FF_PIB_TIKTOK_PHASE_2=true
FF_PIB_TIKTOK_PHASE_3=true
FF_PIB_TIKTOK_PHASE_4=true
FF_PIB_TIKTOK_PHASE_5=true
FF_PIB_TIKTOK_PHASE_6=true
FF_PIB_TIKTOK_PHASE_7=true
