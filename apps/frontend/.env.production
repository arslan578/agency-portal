# Production Environment Variables for Cloudflare Pages
# These will be used during the build process

# API Gateway URL (Render backend)
# API Gateway URL (Relative for Ingress)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_BASE=

# App URLs (use custom domain for production)
NEXTAUTH_URL=https://app.getkaivo.com
NEXT_PUBLIC_APP_URL=https://app.getkaivo.com

# Stripe Publishable Key (safe to expose publicly)
# Get this from: https://dashboard.stripe.com/apikeys
# Use pk_test_... for testing, pk_live_... for production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Shopify Public API Key (Required for App Bridge)
NEXT_PUBLIC_SHOPIFY_API_KEY=a16a6e0eedd127b900e770424e00da41
NEXT_PUBLIC_FF_AUTH_BYPASS_ENABLED=true
