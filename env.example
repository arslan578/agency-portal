# Kaivo Secrets Template
# Copy this file to .env (for local) or use these keys in your Secret Manager (GitHub/K8s)

# --- Database ---
# Connection string for the PostgreSQL database
DATABASE_URL=postgresql://user:password@host:5432/kaivo

# --- Redis ---
# Connection string for Redis (used by Celery)
REDIS_URL=redis://localhost:6379/0

# --- AI Services ---
# API Key for OpenAI (GPT-4)
OPENAI_API_KEY=sk-...

# --- Payments ---
# Stripe Secret Key for billing (Dashboard → Developers → API keys; never commit real values)
STRIPE_SECRET_KEY=
# Stripe Webhook Secret for webhook signature verification (Stripe CLI or Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=

# --- Shopify Integration ---
# Shopify App API Key (from Shopify Partners dashboard)
SHOPIFY_API_KEY=...
# Shopify App API Secret (from Shopify Partners dashboard)
SHOPIFY_API_SECRET=...
# Shopify App URL (e.g., https://app.getkaivo.com)
SHOPIFY_APP_URL=...
# Shopify OAuth Scopes (comma-separated, e.g., read_products,write_products)
SHOPIFY_SCOPES=read_products,write_products

# --- Authentication ---
# Secret used to sign session tokens (generate a random string)
NEXTAUTH_SECRET=...
# URL of the application (e.g., https://staging.getkaivo.com)
NEXTAUTH_URL=...
# Frontend URL for Stripe redirects and magic-link emails (must match agency portal origin)
FRONTEND_URL=http://localhost:3000
# Path on the Next app for accepting invites (default matches apps/agency-portal /verify route)
# MAGIC_LINK_PATH=/verify

# --- Email (Magic Link Invites) ---
# Resend API key — only required to *deliver* invite emails. Without it, invites are still stored;
# use invite_link from the API response or server logs. Get a key at https://resend.com
RESEND_API_KEY=re_...
# JWT secret for backend token signing
SECRET_KEY=change-me-in-production

# --- Google OAuth (for Google Sign-In) ---
GOOGLE_CLIENT_ID=...
NEXT_PUBLIC_GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# --- Cloudflare R2 (Product Documents) ---
# R2 endpoint URL (e.g., https://[account-id].r2.cloudflarestorage.com)
R2_ENDPOINT=https://[account-id].r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_PRODUCT_DOCS=kaivo-product-docs

# --- Meta Ads API (for testing) ---
# Get your access token from: https://developers.facebook.com/tools/explorer/
META_ACCESS_TOKEN=your_meta_access_token_here
META_APP_ID=your_app_id_here
META_APP_SECRET=your_app_secret_here
NEXT_PUBLIC_META_APP_ID=your_app_id_here

# --- Reddit Ads OAuth ---
# Configure this redirect URI in Reddit app settings:
# <FRONTEND_URL>/integrations/reddit/oauth/callback
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=KaivoAds/1.0 (https://getkaivo.com)
REDDIT_ADS_API_BASE_URL=https://ads-api.reddit.com
NEXT_PUBLIC_REDDIT_CLIENT_ID=your_reddit_client_id_here
# Optional override to force exact Reddit callback URI (useful for ngrok/local):
# NEXT_PUBLIC_REDDIT_REDIRECT_URI=https://<your-domain>/integrations/reddit/oauth/callback

# --- Infrastructure (CI/CD Only) ---
# Kubernetes Config (Base64 encoded or raw YAML)
KUBE_CONFIG=...
# GitHub Container Registry Token
GHCR_TOKEN=...
