    "constraints": {
        "budget": {
            "policies": [
                {
                    "id": "MIN_DAILY_BUDGET",
                    "scope": "CAMPAIGN",
                    "unit": "MAJOR_CURRENCY",
                    "expression": "budget_per_day >= platform_min_daily_budget",
                    "enforced_by": [
                        "policy_mirror",
                        "safety_horizon"
                    ],
                    "source": "META_POLICY"
                },
                {
                    "id": "MAX_LIFETIME_BUDGET",
                    "scope": "CAMPAIGN",
                    "unit": "MAJOR_CURRENCY",
                    "expression": "total_budget <= kaivo_workspace_budget_ceiling",
                    "enforced_by": [
                        "workspace_manager",
                        "safety_horizon"
                    ],
                    "source": "KAIVO_POLICY"
                }
            ]
        },
