    "io_schema": {
        "request_contract": {
            "id": "meta_ads_request_contract_v1",
            "required_fields": [
                "execution_id",
                "tenant_context",
                "workspace_context",
                "connector_id",
                "operation",
                "payload",
                "feature_flags",
                "requested_backplane_contract_version"
            ],
            "forbidden_fields": [
                "_debug",
                "debug_info",
                "internal_only"
            ],
            "operations": [
                {
                    "operation": "CREATE_CAMPAIGN",
                    "google_api_method_ref": "facebook.graph.v19.0.act_account_id.campaigns.POST",
                    "payload_shape_ref": "meta_ads_create_campaign_payload_v1",
                    "idempotency_key_strategy": "HASH(tenant_id, workspace_id, campaign_external_reference)"
                },
                {
                    "operation": "CREATE_AD_GROUP",
                    "google_api_method_ref": "facebook.graph.v19.0.act_account_id.adsets.POST",
                    "payload_shape_ref": "meta_ads_create_ad_group_payload_v1",
                    "idempotency_key_strategy": "HASH(tenant_id, workspace_id, ad_group_external_reference)"
                },
                {
                    "operation": "CREATE_AD",
                    "google_api_method_ref": "facebook.graph.v19.0.act_account_id.ads.POST",
                    "payload_shape_ref": "meta_ads_create_ad_payload_v1",
                    "idempotency_key_strategy": "HASH(tenant_id, workspace_id, ad_external_reference)"
                },
                {
                    "operation": "MUTATE_BUDGET",
                    "google_api_method_ref": "facebook.graph.v19.0.campaign_id.POST",
                    "payload_shape_ref": "meta_ads_mutate_budget_payload_v1",
                    "idempotency_key_strategy": "HASH(tenant_id, workspace_id, campaign_id, change_vector)"
                },
                {
                    "operation": "PAUSE_CAMPAIGN",
                    "google_api_method_ref": "facebook.graph.v19.0.campaign_id.POST",
                    "payload_shape_ref": "meta_ads_pause_campaign_payload_v1",
                    "idempotency_key_strategy": "HASH(tenant_id, workspace_id, campaign_id, target_status)"
                }
            ]
        },
        "response_contract": {
            "id": "meta_ads_response_contract_v1",
            "required_fields": [
                "execution_id",
                "tenant_context",
                "workspace_context",
                "connector_id",
                "operation",
                "status",
                "normalized_payload",
                "raw_connector_payload_ref",
                "error",
                "retry_advice",
                "rate_limit_observation"
            ],
            "forbidden_fields": [
                "_debug",
                "debug_info",
                "internal_only"
            ],
            "status_values": [
                "SUCCESS",
                "PARTIAL_SUCCESS",
                "RETRYABLE_ERROR",
                "NON_RETRYABLE_ERROR"
            ],
            "normalized_payload_shape_ref": "meta_ads_normalized_entity_shapes_v1"
        },
        "error_mapping": {
            "id": "meta_ads_error_mapping_v1",
            "domains": [
                {
                    "google_domain": "OAuthException",
                    "mapped_category": "AUTH",
                    "default_retry_policy": "NO_RETRY"
                },
                {
                    "google_domain": "Throttling",
                    "mapped_category": "RATE_LIMIT",
                    "default_retry_policy": "RETRY_WITH_BACKOFF"
                },
                {
                    "google_domain": "Recipients",
                    "mapped_category": "QUOTA",
                    "default_retry_policy": "RETRY_WITH_BACKOFF"
                },
                {
                    "google_domain": "Permissions",
                    "mapped_category": "POLICY",
                    "default_retry_policy": "NO_RETRY"
                },
                {
                    "google_domain": "Service",
                    "mapped_category": "CONNECTOR_INTERNAL",
                    "default_retry_policy": "RETRY_WITH_JITTER"
                }
            ],
            "kaivo_error_codes": [
                {
                    "code": "META_AUTH_FAILED",
                    "category": "AUTH",
                    "retry_policy": "NO_RETRY"
                },
                {
                    "code": "META_RATE_LIMITED",
                    "category": "RATE_LIMIT",
                    "retry_policy": "RETRY_WITH_BACKOFF"
                },
                {
                    "code": "META_POLICY_VIOLATION",
                    "category": "POLICY",
                    "retry_policy": "NO_RETRY"
                },
                {
                    "code": "META_INVALID_REQUEST",
                    "category": "REQUEST",
                    "retry_policy": "NO_RETRY"
                },
                {
                    "code": "META_INTERNAL_ERROR",
                    "category": "CONNECTOR_INTERNAL",
                    "retry_policy": "RETRY_WITH_JITTER"
                }
            ]
        },
        "retry_logic": {
            "policies": [
                {
                    "id": "RETRY_WITH_BACKOFF",
                    "max_attempts": 5,
                    "backoff_strategy": "EXPONENTIAL",
                    "initial_delay_ms": 500,
                    "max_delay_ms": 30000
                },
                {
                    "id": "RETRY_WITH_JITTER",
                    "max_attempts": 3,
                    "backoff_strategy": "EXPONENTIAL_JITTER",
                    "initial_delay_ms": 250,
                    "max_delay_ms": 15000
                },
                {
                    "id": "NO_RETRY",
                    "max_attempts": 1,
                    "backoff_strategy": "NONE",
                    "initial_delay_ms": 0,
                    "max_delay_ms": 0
                }
            ],
            "safe_abort_conditions": [
                "AUTH",
                "POLICY",
                "INVALID_REQUEST"
            ]
        }
    },
    "routing": {
        "profile_id": "meta_ads_routing_profile_v1",
        "default_endpoint": "https://graph.facebook.com/v19.0",
        "supports_batching": true,
        "max_batch_size": 50,
        "concurrency_limits": {
            "per_workspace_max_in_flight": 10,
            "per_tenant_max_in_flight": 50
        },
        "rate_limit_hint": {
            "tokens_per_second_soft_ceiling": 5,
            "burst_size_soft_ceiling": 10
        },
        "timeout_ms": {
            "connect_timeout_ms": 3000,
            "read_timeout_ms": 60000
        }
    },
    "safety_profile": {
        "risk_weight": "HIGH",
        "quota_consumption_model_ref": "meta_ads_quota_model_v1",
        "connector_health_signals_ref": "meta_ads_health_signals_v1",
        "safety_horizon_bindings": {
            "uses_policy_mirror": true,
            "uses_safety_horizon": true,
            "uses_rate_limit_forecaster": true,
            "uses_capability_drift_model": true
        }
    },
    "knowledge_sources": {
