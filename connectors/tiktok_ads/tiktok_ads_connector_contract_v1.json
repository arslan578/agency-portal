            ],
            "normalized_payload_shape_ref": "tiktok_ads_normalized_entity_shapes_v1"
        },
        "error_mapping": {
            "id": "tiktok_ads_error_mapping_v1",
            "domains": [
                {
                    "tiktok_domain": "AUTHENTICATION_ERROR",
                    "mapped_category": "AUTH",
                    "default_retry_policy": "NO_RETRY"
                },
                {
                    "tiktok_domain": "RATE_LIMIT_ERROR",
                    "mapped_category": "RATE_LIMIT",
                    "default_retry_policy": "RETRY_WITH_BACKOFF"
                },
                {
                    "tiktok_domain": "QUOTA_ERROR",
                    "mapped_category": "QUOTA",
                    "default_retry_policy": "RETRY_WITH_BACKOFF"
                },
                {
                    "tiktok_domain": "POLICY_VIOLATION_ERROR",
                    "mapped_category": "POLICY",
                    "default_retry_policy": "NO_RETRY"
                },
                {
                    "tiktok_domain": "INTERNAL_ERROR",
                    "mapped_category": "CONNECTOR_INTERNAL",
                    "default_retry_policy": "RETRY_WITH_JITTER"
                }
            ],
            "kaivo_error_codes": [
                {
                    "code": "TIKTOK_AUTH_FAILED",
                    "category": "AUTH",
                    "retry_policy": "NO_RETRY"
                },
                {
                    "code": "TIKTOK_RATE_LIMITED",
                    "category": "RATE_LIMIT",
                    "retry_policy": "RETRY_WITH_BACKOFF"
                },
                {
                    "code": "TIKTOK_POLICY_VIOLATION",
                    "category": "POLICY",
                    "retry_policy": "NO_RETRY"
                },
                {
                    "code": "TIKTOK_INVALID_REQUEST",
                    "category": "REQUEST",
                    "retry_policy": "NO_RETRY"
                },
                {
                    "code": "TIKTOK_INTERNAL_ERROR",
                    "category": "CONNECTOR_INTERNAL",
                    "retry_policy": "RETRY_WITH_JITTER"
                }
            ]
        },
        "retry_logic": {
            "policies": [
                {
                    "id": "RETRY_WITH_BACKOFF",
                    "max_attempts": 3,
                    "backoff_strategy": "EXPONENTIAL",
                    "initial_delay_ms": 500,
                    "max_delay_ms": 30000
                },
                {
                    "id": "RETRY_WITH_JITTER",
                    "max_attempts": 2,
                    "backoff_strategy": "EXPONENTIAL_JITTER",
                    "initial_delay_ms": 250,
                    "max_delay_ms": 15000
                },
                {
                    "id": "NO_RETRY",
                    "max_attempts": 1,
                    "backoff_strategy": "NONE",
                    "initial_delay_ms": 0,
                    "max_delay_ms": 0
                }
            ],
            "safe_abort_conditions": [
                "AUTH",
                "POLICY",
                "INVALID_REQUEST"
            ]
        }
    },
