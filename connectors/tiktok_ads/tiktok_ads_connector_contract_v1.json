    "io_schema": {
        "request_contract": {
            "id": "tiktok_ads_request_contract_v1",
            "required_fields": [
                "execution_id",
                "tenant_context",
                "workspace_context",
                "connector_id",
                "operation",
                "payload",
                "feature_flags",
                "requested_backplane_contract_version"
            ],
            "forbidden_fields": [
                "_debug",
                "debug_info",
                "internal_only"
            ],
            "operations": [
                {
                    "operation": "CREATE_CAMPAIGN",
                    "tiktok_api_method_ref": "tiktok.business.v1.3.advertiser.campaign.create",
                    "payload_shape_ref": "tiktok_ads_create_campaign_payload_v1",
                    "idempotency_key_strategy": "HASH(tenant_id, workspace_id, campaign_external_reference)"
                },
                {
                    "operation": "CREATE_AD_GROUP",
                    "tiktok_api_method_ref": "tiktok.business.v1.3.advertiser.adgroup.create",
                    "payload_shape_ref": "tiktok_ads_create_ad_group_payload_v1",
                    "idempotency_key_strategy": "HASH(tenant_id, workspace_id, ad_group_external_reference)"
                },
                {
                    "operation": "CREATE_AD",
                    "tiktok_api_method_ref": "tiktok.business.v1.3.advertiser.ad.create",
                    "payload_shape_ref": "tiktok_ads_create_ad_payload_v1",
                    "idempotency_key_strategy": "HASH(tenant_id, workspace_id, ad_external_reference)"
                },
                {
                    "operation": "MUTATE_BUDGET",
                    "tiktok_api_method_ref": "tiktok.business.v1.3.advertiser.campaign.update",
                    "payload_shape_ref": "tiktok_ads_mutate_budget_payload_v1",
                    "idempotency_key_strategy": "HASH(tenant_id, workspace_id, campaign_id, change_vector)"
                },
                {
                    "operation": "PAUSE_CAMPAIGN",
                    "tiktok_api_method_ref": "tiktok.business.v1.3.advertiser.campaign.update",
                    "payload_shape_ref": "tiktok_ads_pause_campaign_payload_v1",
                    "idempotency_key_strategy": "HASH(tenant_id, workspace_id, campaign_id, target_status)"
                }
            ]
        },
        "response_contract": {
            "id": "tiktok_ads_response_contract_v1",
