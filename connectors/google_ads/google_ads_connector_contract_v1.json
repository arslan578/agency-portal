                    "payload_shape_ref": "google_ads_create_ad_payload_v1",
                    "idempotency_key_strategy": "HASH(tenant_id, workspace_id, ad_external_reference)"
                },
                {
                    "operation": "MUTATE_BUDGET",
                    "google_api_method_ref": "google.ads.googleads.vN.services.CampaignBudgetService.MutateCampaignBudgets",
                    "payload_shape_ref": "google_ads_mutate_budget_payload_v1",
                    "idempotency_key_strategy": "HASH(tenant_id, workspace_id, campaign_id, change_vector)"
                },
                {
                    "operation": "PAUSE_CAMPAIGN",
                    "google_api_method_ref": "google.ads.googleads.vN.services.CampaignService.MutateCampaigns",
                    "payload_shape_ref": "google_ads_pause_campaign_payload_v1",
                    "idempotency_key_strategy": "HASH(tenant_id, workspace_id, campaign_id, target_status)"
                }
            ]
        },
