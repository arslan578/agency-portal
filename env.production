# Kaivo production environment — template only.
# Copy to a private env file or inject via your host/secret manager; do not commit real secrets.

# --- Database ---
DATABASE_URL=CHANGE_ME_PRODUCTION

# --- Redis ---
REDIS_URL=CHANGE_ME_PRODUCTION

# --- AI Services ---
OPENAI_API_KEY=CHANGE_ME_PRODUCTION

# --- Payments ---
STRIPE_SECRET_KEY=CHANGE_ME_PRODUCTION
STRIPE_WEBHOOK_SECRET=CHANGE_ME_PRODUCTION
FRONTEND_URL=https://app.getkaivo.com

# --- Authentication ---
NEXTAUTH_SECRET=CHANGE_ME_PRODUCTION
NEXTAUTH_URL=https://app.getkaivo.com
NEXT_PUBLIC_APP_URL=https://app.getkaivo.com
NEXT_PUBLIC_API_URL=https://api.getkaivo.com
CORS_ALLOWED_ORIGINS=https://app.getkaivo.com
ALLOWED_HOSTS=api.getkaivo.com

# --- Google OAuth (sign-in) ---
GOOGLE_CLIENT_ID=CHANGE_ME_PRODUCTION
GOOGLE_CLIENT_SECRET=CHANGE_ME_PRODUCTION

# --- Google Ads API ---
GOOGLE_ADS_DEVELOPER_TOKEN=CHANGE_ME_PRODUCTION
GOOGLE_ADS_CLIENT_ID=CHANGE_ME_PRODUCTION
GOOGLE_ADS_CLIENT_SECRET=CHANGE_ME_PRODUCTION
GOOGLE_ADS_REFRESH_TOKEN=CHANGE_ME_PRODUCTION
GOOGLE_ADS_CUSTOMER_ID=CHANGE_ME_PRODUCTION
GOOGLE_ADS_LOGIN_CUSTOMER_ID=CHANGE_ME_PRODUCTION

# --- Meta Ads API ---
META_APP_ID=CHANGE_ME_PRODUCTION
META_APP_SECRET=CHANGE_ME_PRODUCTION
META_ACCESS_TOKEN=CHANGE_ME_PRODUCTION
META_AD_ACCOUNT_ID=CHANGE_ME_PRODUCTION

# --- TikTok Ads API ---
TIKTOK_APP_ID=CHANGE_ME_PRODUCTION
TIKTOK_APP_SECRET=CHANGE_ME_PRODUCTION
TIKTOK_ACCESS_TOKEN=CHANGE_ME_PRODUCTION
TIKTOK_ADVERTISER_ID=CHANGE_ME_PRODUCTION

# --- Cloudinary Media Storage ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Infrastructure (CI/CD Only) ---
KUBE_CONFIG=CHANGE_ME_PRODUCTION
GHCR_TOKEN=CHANGE_ME_PRODUCTION
